# Copy this file to .env (it is git-ignored). `npm start`, `npm run dev` and `npm run eval` read it.
# Optional: enables the AI reviewer. Get a key at https://aistudio.google.com/apikey
# Without it, Keel runs in rules-only mode and every core workflow still works.
GEMINI_API_KEY=
# Optional: pin a model. Default is Google's rolling alias for the current Flash model.
GEMINI_MODEL=gemini-flash-latest
PORT=8787
# KEEL_DATA_DIR=./data
